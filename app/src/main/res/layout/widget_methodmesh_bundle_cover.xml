<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:background="@drawable/widget_bundle_stack_back_far"
        android:translationX="5dp"
        android:translationY="-5dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="5dp"
        android:background="@drawable/widget_bundle_stack_back_near"
        android:translationX="3dp"
        android:translationY="-3dp" />

    <LinearLayout
        android:id="@+id/widgetBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:background="@drawable/widget_bg_teal_solid"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/widgetContentPlate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_content_plate_clear"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="6dp"
            android:paddingTop="5dp"
            android:paddingRight="6dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/widgetIcon"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:contentDescription="@string/app_name"
                android:gravity="center"
                android:text="🧰"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/widgetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="Field tools"
                android:textColor="#302A28"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/bundleCountBadge"
        android:layout_width="26dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/widget_bundle_count_badge"
        android:gravity="center"
        android:text="6"
        android:textColor="#FFFFFFFF"
        android:textSize="9sp"
        android:textStyle="bold" />
</FrameLayout>
