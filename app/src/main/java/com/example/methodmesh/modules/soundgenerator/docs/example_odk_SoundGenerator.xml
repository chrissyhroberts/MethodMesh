<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>MethodMesh Sound Generator example</h:title><model odk:xforms-version="1.0.0"><instance><data id="methodmesh_sound_generator_example" version="2026090301"><intro/><sound_config><stimulus_type/><waveform/><frequency_hz/><noise_type/><sweep_start_hz/><sweep_end_hz/><sweep_scale/><level_dbfs/><duration_ms/><channel/><fade_ms/><gate_mode/><pulse_on_ms/><pulse_off_ms/><sample_rate_hz/><noise_seed_mode/><noise_seed/><output_device_id/><system_volume_policy/><system_volume_percent/></sound_config><methodmesh_result><sound_status/><sound_summary/><sound_pcm_sha256/><sound_written_pcm_sha256/><sound_noise_seed/><sound_routed_device/><sound_frames_played/><sound_started_time_iso/><sound_finished_time_iso/><sound_audit_json/><sound_error/></methodmesh_result><meta><instanceID/></meta></data></instance><instance id="stimulus_type"><root><item><name>tone</name><label>Tone</label></item><item><name>noise</name><label>Noise</label></item><item><name>sweep</name><label>Frequency sweep</label></item></root></instance><instance id="waveform"><root><item><name>sine</name><label>Sine</label></item><item><name>square</name><label>Square</label></item><item><name>triangle</name><label>Triangle</label></item><item><name>sawtooth</name><label>Sawtooth</label></item></root></instance><instance id="noise_type"><root><item><name>white</name><label>White</label></item><item><name>pink</name><label>Pink</label></item><item><name>brown</name><label>Brown</label></item></root></instance><instance id="sweep_scale"><root><item><name>logarithmic</name><label>Logarithmic</label></item><item><name>linear</name><label>Linear</label></item></root></instance><instance id="channel"><root><item><name>both</name><label>Both</label></item><item><name>left</name><label>Left only</label></item><item><name>right</name><label>Right only</label></item></root></instance><instance id="gate_mode"><root><item><name>steady</name><label>Steady</label></item><item><name>pulsed</name><label>Pulsed</label></item></root></instance><instance id="sample_rate"><root><item><name>48000</name><label>48 kHz</label></item><item><name>44100</name><label>44.1 kHz</label></item></root></instance><instance id="seed_mode"><root><item><name>secure_random</name><label>New random seed each run</label></item><item><name>fixed_seed</name><label>Fixed reproducible seed</label></item></root></instance><instance id="volume_policy"><root><item><name>preserve</name><label>Preserve current volume</label></item><item><name>require_percent</name><label>Require configured volume</label></item><item><name>temporary_set_percent</name><label>Set temporarily, then restore</label></item></root></instance><bind nodeset="/data/intro" readonly="true()" type="string"/><bind nodeset="/data/sound_config/stimulus_type" type="string" required="true()"/><bind nodeset="/data/sound_config/waveform" type="string" required="true()"/><bind nodeset="/data/sound_config/frequency_hz" type="decimal" constraint=". &gt;= 1 and . &lt; 24000" jr:constraintMsg="Enter a frequency between 1 and 23999 Hz."/><bind nodeset="/data/sound_config/noise_type" type="string"/><bind nodeset="/data/sound_config/sweep_start_hz" type="decimal" constraint=". &gt;= 1 and . &lt; 24000" jr:constraintMsg="Enter a frequency between 1 and 23999 Hz."/><bind nodeset="/data/sound_config/sweep_end_hz" type="decimal" constraint=". &gt;= 1 and . &lt; 24000" jr:constraintMsg="Enter a frequency between 1 and 23999 Hz."/><bind nodeset="/data/sound_config/sweep_scale" type="string"/><bind nodeset="/data/sound_config/level_dbfs" type="decimal" required="true()" constraint=". &gt;= -80 and . &lt;= 0" jr:constraintMsg="Enter a value from -80 to 0 dBFS."/><bind nodeset="/data/sound_config/duration_ms" type="int" required="true()" constraint=". &gt;= 20 and . &lt;= 60000" jr:constraintMsg="Enter 20–60000 ms."/><bind nodeset="/data/sound_config/channel" type="string" required="true()"/><bind nodeset="/data/sound_config/fade_ms" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 5000" jr:constraintMsg="Enter 0–5000 ms."/><bind nodeset="/data/sound_config/gate_mode" type="string" required="true()"/><bind nodeset="/data/sound_config/pulse_on_ms" type="int" constraint=". &gt;= 5 and . &lt;= 60000" jr:constraintMsg="Enter 5–60000 ms."/><bind nodeset="/data/sound_config/pulse_off_ms" type="int" constraint=". &gt;= 0 and . &lt;= 60000" jr:constraintMsg="Enter 0–60000 ms."/><bind nodeset="/data/sound_config/sample_rate_hz" type="string" required="true()"/><bind nodeset="/data/sound_config/noise_seed_mode" type="string"/><bind nodeset="/data/sound_config/noise_seed" type="string"/><bind nodeset="/data/sound_config/output_device_id" type="string"/><bind nodeset="/data/sound_config/system_volume_policy" type="string" required="true()"/><bind nodeset="/data/sound_config/system_volume_percent" type="int" constraint=". &gt;= 0 and . &lt;= 100" jr:constraintMsg="Enter 0–100%."/><bind nodeset="/data/methodmesh_result/sound_status" type="string" readonly="true()"/><bind nodeset="/data/methodmesh_result/sound_summary" type="string" readonly="true()"/><bind nodeset="/data/methodmesh_result/sound_pcm_sha256" type="string" readonly="true()"/><bind nodeset="/data/methodmesh_result/sound_written_pcm_sha256" type="string" readonly="true()"/><bind nodeset="/data/methodmesh_result/sound_noise_seed" type="string" readonly="true()"/><bind nodeset="/data/methodmesh_result/sound_routed_device" type="string" readonly="true()"/><bind nodeset="/data/methodmesh_result/sound_frames_played" type="int" readonly="true()"/><bind nodeset="/data/methodmesh_result/sound_started_time_iso" type="string" readonly="true()"/><bind nodeset="/data/methodmesh_result/sound_finished_time_iso" type="string" readonly="true()"/><bind nodeset="/data/methodmesh_result/sound_audit_json" type="string" readonly="true()"/><bind nodeset="/data/methodmesh_result/sound_error" type="string" readonly="true()"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/></model></h:head><h:body><input ref="/data/intro"><label>MethodMesh Sound Generator example</label><hint>Digital dBFS is not dB SPL or dB HL. Start with conservative output levels, especially with headphones.</hint></input><group appearance="field-list" ref="/data/sound_config"><label>Configure sound</label><select1 ref="/data/sound_config/stimulus_type"><label>Sound type</label><itemset nodeset="instance('stimulus_type')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sound_config/waveform"><label>Waveform</label><hint>Used for tones and sweeps.</hint><itemset nodeset="instance('waveform')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sound_config/frequency_hz"><label>Tone frequency (Hz)</label></input><select1 ref="/data/sound_config/noise_type"><label>Noise type</label><itemset nodeset="instance('noise_type')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sound_config/sweep_start_hz"><label>Sweep start (Hz)</label></input><input ref="/data/sound_config/sweep_end_hz"><label>Sweep end (Hz)</label></input><select1 ref="/data/sound_config/sweep_scale"><label>Sweep scale</label><itemset nodeset="instance('sweep_scale')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sound_config/level_dbfs"><label>Digital peak level (dBFS)</label><hint>This is a digital full-scale value, not an acoustic sound-pressure level.</hint></input><input ref="/data/sound_config/duration_ms"><label>Duration (ms)</label></input><select1 ref="/data/sound_config/channel"><label>Channel</label><itemset nodeset="instance('channel')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sound_config/fade_ms"><label>Fade in/out (ms)</label></input><select1 ref="/data/sound_config/gate_mode"><label>Pattern</label><itemset nodeset="instance('gate_mode')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sound_config/pulse_on_ms"><label>Pulse on (ms)</label></input><input ref="/data/sound_config/pulse_off_ms"><label>Pulse off (ms)</label></input><select1 ref="/data/sound_config/sample_rate_hz"><label>Sample rate</label><itemset nodeset="instance('sample_rate')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/sound_config/noise_seed_mode"><label>Noise seed mode</label><itemset nodeset="instance('seed_mode')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sound_config/noise_seed"><label>Fixed noise seed</label><hint>Used when seed mode is fixed_seed.</hint></input><input ref="/data/sound_config/output_device_id"><label>Preferred Android audio device ID</label><hint>Leave blank to use the system default route.</hint></input><select1 ref="/data/sound_config/system_volume_policy"><label>System media-volume policy</label><itemset nodeset="instance('volume_policy')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/sound_config/system_volume_percent"><label>Required / temporary media volume (%)</label></input></group><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='sound.play',input_stimulus_type= /data/sound_config/stimulus_type ,input_waveform= /data/sound_config/waveform ,input_frequency_hz= /data/sound_config/frequency_hz ,input_noise_type= /data/sound_config/noise_type ,input_sweep_start_hz= /data/sound_config/sweep_start_hz ,input_sweep_end_hz= /data/sound_config/sweep_end_hz ,input_sweep_scale= /data/sound_config/sweep_scale ,input_level_dbfs= /data/sound_config/level_dbfs ,input_duration_ms= /data/sound_config/duration_ms ,input_channel= /data/sound_config/channel ,input_fade_ms= /data/sound_config/fade_ms ,input_gate_mode= /data/sound_config/gate_mode ,input_pulse_on_ms= /data/sound_config/pulse_on_ms ,input_pulse_off_ms= /data/sound_config/pulse_off_ms ,input_sample_rate_hz= /data/sound_config/sample_rate_hz ,input_noise_seed_mode= /data/sound_config/noise_seed_mode ,input_noise_seed= /data/sound_config/noise_seed ,input_output_device_id= /data/sound_config/output_device_id ,input_system_volume_policy= /data/sound_config/system_volume_policy ,input_system_volume_percent= /data/sound_config/system_volume_percent ,return_mode='flat')" ref="/data/methodmesh_result"><label>Play sound with MethodMesh</label><input ref="/data/methodmesh_result/sound_status"><label>Status</label></input><input ref="/data/methodmesh_result/sound_summary"><label>Playback summary</label></input><input ref="/data/methodmesh_result/sound_pcm_sha256"><label>Generated PCM SHA-256</label></input><input ref="/data/methodmesh_result/sound_written_pcm_sha256"><label>AudioTrack-written PCM SHA-256</label></input><input ref="/data/methodmesh_result/sound_noise_seed"><label>Noise seed used</label></input><input ref="/data/methodmesh_result/sound_routed_device"><label>Actual routed device</label></input><input ref="/data/methodmesh_result/sound_frames_played"><label>Frames played</label></input><input ref="/data/methodmesh_result/sound_started_time_iso"><label>Started time</label></input><input ref="/data/methodmesh_result/sound_finished_time_iso"><label>Finished time</label></input><input ref="/data/methodmesh_result/sound_audit_json" appearance="multiline"><label>Full audit JSON</label></input><input ref="/data/methodmesh_result/sound_error" appearance="multiline"><label>Error / interruption detail</label></input></group></h:body></h:html>