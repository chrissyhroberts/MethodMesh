<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms" xmlns:orx="http://openrosa.org/xforms" xmlns:xsd="http://www.w3.org/2001/XMLSchema"><h:head><h:title>MethodMesh conversation translator</h:title><model odk:xforms-version="1.0.0"><instance><data id="example_odk_conversation_translate" version="2026090102"><start/><language_a_input>en</language_a_input><language_b_input>es</language_b_input><spoken_output_input>true</spoken_output_input><prefer_offline_input>true</prefer_offline_input><conversation_translation><methodmesh_execution_id/><methodmesh_status/><conversation_transcript/><methodmesh_full_json/></conversation_translation><conversation_done/><end/><meta><instanceID/></meta></data></instance><bind jr:preload="timestamp" jr:preloadParams="start" nodeset="/data/start" type="dateTime"/><bind nodeset="/data/language_a_input" required="true()" type="string"/><bind nodeset="/data/language_b_input" required="true()" type="string"/><bind nodeset="/data/spoken_output_input" required="true()" type="string"/><bind nodeset="/data/prefer_offline_input" required="true()" type="string"/><bind nodeset="/data/conversation_translation/methodmesh_execution_id" readonly="true()" type="string"/><bind nodeset="/data/conversation_translation/methodmesh_status" readonly="true()" type="string"/><bind nodeset="/data/conversation_translation/conversation_transcript" readonly="true()" type="string"/><bind nodeset="/data/conversation_translation/methodmesh_full_json" readonly="true()" type="string"/><bind nodeset="/data/conversation_done" readonly="true()" relevant=" /data/conversation_translation/conversation_transcript  != ''" type="string"/><bind jr:preload="timestamp" jr:preloadParams="end" nodeset="/data/end" type="dateTime"/><bind jr:preload="uid" nodeset="/data/meta/instanceID" readonly="true()" type="string"/></model></h:head><h:body><select1 ref="/data/language_a_input"><label>First language</label><hint>Download the language pack in MethodMesh settings before offline use.</hint><item><label>English (En)</label><value>en</value></item><item><label>Spanish (Es)</label><value>es</value></item><item><label>French (Fr)</label><value>fr</value></item><item><label>Portuguese (Pt)</label><value>pt</value></item><item><label>German (De)</label><value>de</value></item><item><label>Italian (It)</label><value>it</value></item><item><label>Arabic (Ar)</label><value>ar</value></item><item><label>Hindi (Hi)</label><value>hi</value></item><item><label>Swahili (Sw)</label><value>sw</value></item><item><label>Chinese (Zh)</label><value>zh</value></item><item><label>Krio (Kri) — if supported by installed translation engine</label><value>kri</value></item></select1><select1 ref="/data/language_b_input"><label>Second language</label><hint>Download the language pack in MethodMesh settings before offline use.</hint><item><label>English (En)</label><value>en</value></item><item><label>Spanish (Es)</label><value>es</value></item><item><label>French (Fr)</label><value>fr</value></item><item><label>Portuguese (Pt)</label><value>pt</value></item><item><label>German (De)</label><value>de</value></item><item><label>Italian (It)</label><value>it</value></item><item><label>Arabic (Ar)</label><value>ar</value></item><item><label>Hindi (Hi)</label><value>hi</value></item><item><label>Swahili (Sw)</label><value>sw</value></item><item><label>Chinese (Zh)</label><value>zh</value></item><item><label>Krio (Kri) — if supported by installed translation engine</label><value>kri</value></item></select1><select1 ref="/data/spoken_output_input"><label>Speak translations aloud</label><item><label>Yes</label><value>true</value></item><item><label>No</label><value>false</value></item></select1><select1 ref="/data/prefer_offline_input"><label>Prefer offline speech recognition</label><item><label>Yes</label><value>true</value></item><item><label>No</label><value>false</value></item></select1><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='conversation.translate',input_language_a= /data/language_a_input ,input_language_b= /data/language_b_input ,input_spoken_output= /data/spoken_output_input ,input_prefer_offline= /data/prefer_offline_input ,input_payload_mode='FULL',return_mode='flat')" ref="/data/conversation_translation"><label>Run conversation translator</label><input ref="/data/conversation_translation/methodmesh_execution_id"><label>MethodMesh execution ID</label></input><input ref="/data/conversation_translation/methodmesh_status"><label>MethodMesh status</label></input><input ref="/data/conversation_translation/conversation_transcript"><label>Conversation transcript</label></input><input ref="/data/conversation_translation/methodmesh_full_json"><label>MethodMesh metadata JSON</label></input></group><input ref="/data/conversation_done"><label>Conversation transcript captured: <output value=" /data/conversation_translation/conversation_transcript "/></label></input></h:body></h:html>