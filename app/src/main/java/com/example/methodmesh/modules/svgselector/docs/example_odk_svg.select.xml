<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>svg.select</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="svg_select" version="2">
          <svg_selector><svg_name/><selection_mode/><selected_polygons/><selected_polygon_ids/><selected_count/><selection_summary/><polygon_levels/><heatmap_max_level/><selection_events/><selection_audit_hash/><selection_started_at/><selection_completed_at/></svg_selector>
          <meta><instanceID/></meta>
        </data>
      </instance>
      <instance id="selection_mode"><root><item><name>single</name><label>Select one</label></item><item><name>multiple</name><label>Select multiple</label></item><item><name>sequence</name><label>Select in sequence</label></item><item><name>heatmap</name><label>Heat map / repeated taps</label></item></root></instance>
      <bind nodeset="/data/svg_selector/svg_name" type="string" readonly="true()"/>
      <bind nodeset="/data/svg_selector/selection_mode" type="string" readonly="true()"/>
      <bind nodeset="/data/svg_selector/selected_polygons" type="string" readonly="true()"/>
      <bind nodeset="/data/svg_selector/selected_polygon_ids" type="string" readonly="true()"/>
      <bind nodeset="/data/svg_selector/selected_count" type="string" readonly="true()"/>
      <bind nodeset="/data/svg_selector/selection_summary" type="string" readonly="true()"/>
      <bind nodeset="/data/svg_selector/polygon_levels" type="string" readonly="true()"/>
      <bind nodeset="/data/svg_selector/heatmap_max_level" type="string" readonly="true()"/>
      <bind nodeset="/data/svg_selector/selection_events" type="string" readonly="true()"/>
      <bind nodeset="/data/svg_selector/selection_audit_hash" type="string" readonly="true()"/>
      <bind nodeset="/data/svg_selector/selection_started_at" type="string" readonly="true()"/>
      <bind nodeset="/data/svg_selector/selection_completed_at" type="string" readonly="true()"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='svg.select',input_svg_name='bodymap_black.svg',input_selection_mode='heatmap',input_heatmap_levels='5',return_mode='flat')" ref="/data/svg_selector">
      <label>SVG polygon selection</label>
      <input ref="/data/svg_selector/svg_name"><label>SVG filename</label></input>
      <input ref="/data/svg_selector/selection_mode"><label>Selection mode</label></input>
      <input ref="/data/svg_selector/selected_polygons"><label>Selected polygons</label></input>
      <input ref="/data/svg_selector/selected_polygon_ids"><label>Selected polygon IDs</label></input>
      <input ref="/data/svg_selector/selected_count"><label>Selected polygon count</label></input>
      <input ref="/data/svg_selector/selection_summary"><label>Selection summary</label></input>
      <input ref="/data/svg_selector/polygon_levels"><label>Polygon heat levels</label></input>
      <input ref="/data/svg_selector/heatmap_max_level"><label>Heat-map maximum level</label></input>
      <input ref="/data/svg_selector/selection_events"><label>Selection events</label></input>
      <input ref="/data/svg_selector/selection_audit_hash"><label>Selection audit hash</label></input>
      <input ref="/data/svg_selector/selection_started_at"><label>Selection started</label></input>
      <input ref="/data/svg_selector/selection_completed_at"><label>Selection completed</label></input>
    </group>
  </h:body>
</h:html>
