ng"/><bind nodeset="/data/direct_text_result/methodmesh_full_json" readonly="true()" type="string"/><bind nodeset="/data/direct_file_source" required="true()" type="binary"/><bind nodeset="/data/direct_file_tsa_url" type="string"/><bind constraint=". &gt;= 1000 and . &lt;= 30000" jr:constraintMsg="Use 1000–30000 ms." nodeset="/data/direct_file_timeout_ms" type="int"/><bind nodeset="/data/direct_file_result/trusted_timestamp_proof_uri" readonly="true()" type="binary"/><bind nodeset="/data/direct_file_result/methodmesh_status" readonly="true()" type="string"/><bind nodeset="/data/direct_file_result/methodmesh_full_json" readonly="true()" type="string"/><bind nodeset="/data/interactive_tsa_url" type="string"/><bind constraint=". &gt;= 1000 and . &lt;= 30000" jr:constraintMsg="Use 1000–30000 ms." nodeset="/data/interactive_timeout_ms" type="int"/><bind nodeset="/data/interactive_result/trusted_timestamp_proof_uri" readonly="true()" type="binary"/><bind nodeset="/data/interactive_result/trusted_timestamp_source_uri" readonly="true()" type="binary"/><bind nodeset="/data/interactive_result/trusted_timestamp_source_text" readonly="true()" type="string"/><bind nodeset="/data/interactive_result/methodmesh_status" readonly="true()" type="string"/><bind nodeset="/data/interactive_result/methodmesh_full_json" readonly="true()" type="string"/><bind nodeset="/data/done" readonly="true()" type="string"/><bind jr:preload="uid" nodeset="/data/meta/instanceID" readonly="true()" type="string"/></model></h:head><h:body><input ref="/data/intro"><label>MethodMesh Trusted timestamp — integrity.trusted_timestamp</label><hint>Demonstrates direct text, direct file, and MethodMesh interactive acquisition. Returned files are ODK attachments, not raw phone paths.</hint></input><input ref="/data/namespace_note"><label>Return namespaces are optional here.</label><hint>The same canonical return leaf names are reused in separate groups; ODK disambiguates them by full group path.</hint></input><input ref="/data/direct_text_source"><label>Direct text source</label><hint>ODK supplies these exact UTF-8 bytes to MethodMesh.</hint></input><input ref="/data/direct_text_tsa_url"><label>Direct text TSA URL</label><hint>Optional. Leave blank for the MethodMesh default TSA.</hint></input><input ref="/data/direct_text_timeout_ms"><label>Direct text timeout (ms)</label><hint>Optional network timeout, 1000–30000 ms.</hint></input><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='integrity.trusted_timestamp',input_text= /data/direct_text_source ,input_tsa_url= /data/direct_text_tsa_url ,input_timeout_ms= /data/direct_text_timeout_ms ,return_mode='flat',input_payload_mode='FULL')" ref="/data/direct_text_result"><label>1. Direct text → trusted timestamp</label><upload appearance="hidden-answer" mediatype="application/*" ref="/data/direct_text_result/trusted_timestamp_proof_uri"><label>Proof ZIP attachment</label><hint>The historical canonical key ends in _uri, but ODK receives/imports the ZIP as an attachment.</hint></upload><input appearance="hidden-answer" ref="/data/direct_text_result/methodmesh_status"><label>MethodMesh status</label><hint>Shared transport status.</hint></input><input appearance="hidden-answer" ref="/data/direct_text_result/methodmesh_full_json"><label>MethodMesh metadata JSON</label><hint>Shared complete execution/audit envelope; always captured on a handled roundtrip.</hint></input></group><upload mediatype="application/*" ref="/data/direct_file_source"><label>Direct file source</label><hint>Choose a file in ODK. The file is pushed to MethodMesh as input_file.</hint></upload><input ref="/data/direct_file_tsa_url"><label>Direct file TSA URL</label><hint>Optional. Leave blank for the MethodMesh default TSA.</hint></input><input ref="/data/direct_file_timeout_ms"><label>Direct file timeout (ms)</label><hint>Optional network timeout, 1000–30000 ms.</hint></input><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='integrity.trusted_timestamp',input_file= /data/direct_file_source ,input_tsa_url= /data/direct_file_tsa_url ,input_timeout_ms= /data/direct_file_timeout_ms ,return_mode='flat',input_payload_mode='FULL')" ref="/data/direct_file_result"><label>2. Direct file → trusted timestamp</label><upload appearance="hidden-answer" mediatype="application/*" ref="/data/direct_file_result/trusted_timestamp_proof_uri"><label>Proof ZIP attachment</label><hint>The historical canonical key ends in _uri, but ODK receives/imports the ZIP as an attachment.</hint></upload><input appearance="hidden-answer" ref="/data/direct_file_result/methodmesh_status"><label>MethodMesh status</label><hint>Shared transport status.</hint></input><input appearance="hidden-answer" ref="/data/direct_file_result/methodmesh_full_json"><label>MethodMesh metadata JSON</label><hint>Shared complete execution/audit envelope; always captured on a handled roundtrip.</hint></input></group><input ref="/data/interactive_tsa_url"><label>Interactive TSA URL</label><hint>Optional. Leave blank for the MethodMesh default TSA.</hint></input><input ref="/data/interactive_timeout_ms"><label>Interactive timeout (ms)</label><hint>Optional network timeout, 1000–30000 ms.</hint></input><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='integrity.trusted_timestamp',input_tsa_url= /data/interactive_tsa_url ,input_timeout_ms= /data/interactive_timeout_ms ,return_mode='flat',input_payload_mode='FULL')" ref="/data/interactive_result"><label>3. MethodMesh acquires source</label><upload appearance="hidden-answer" mediatype="application/*" ref="/data/interactive_result/trusted_timestamp_proof_uri"><label>Proof ZIP attachment</label><hint>The historical canonical key ends in _uri, but ODK receives/imports the ZIP as an attachment.</hint></upload><upload appearance="hidden-answer" mediatype="application/*" ref="/data/interactive_result/trusted_timestamp_source_uri"><label>Source file returned by MethodMesh</label><hint>Populated only when the MethodMesh picker acquired the source. ODK receives the file attachment.</hint></upload><input appearance="hidden-answer" ref="/data/interactive_result/trusted_timestamp_source_text"><label>Source text returned by MethodMesh</label><hint>Populated only when text was entered in MethodMesh.</hint></input><input appearance="hidden-answer" ref="/data/interactive_result/methodmesh_status"><label>MethodMesh status</label><hint>Shared transport status.</hint></input><input appearance="hidden-answer" ref="/data/interactive_result/methodmesh_full_json"><label>MethodMesh metadata JSON</label><hint>Shared complete execution/audit envelope; always captured on a handled roundtrip.</hint></input></group><input ref="/data/done"><label>Trusted timestamp examples complete.</label><hint>Direct-source groups keep the original ODK source in place. Interactive acquisition returns the source because MethodMesh collected it on ODK's behalf.</hint></input></h:body></h:html>