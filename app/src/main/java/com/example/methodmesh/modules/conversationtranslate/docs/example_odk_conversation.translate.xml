<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>MethodMesh conversation translator</h:title><model odk:xforms-version="1.0.0"><instance><data id="example_odk_conversation_translate" version="2026090102"><start/><language_a_input>en</language_a_input><language_b_input>es</language_b_input><spoken_output_input>true</spoken_output_input><prefer_offline_input>true</prefer_offline_input><conversation_translation><methodmesh_execution_id/><methodmesh_status/><conversation_transcript/><methodmesh_full_json/></conversation_translation><conversation_done/><end/><meta><instanceID/></meta></data></instance><instance id="language"><root><item><name>en</name><label>English (En)</label></item><item><name>es</name><label>Spanish (Es)</label></item><item><name>fr</name><label>French (Fr)</label></item><item><name>pt</name><label>Portuguese (Pt)</label></item><item><name>de</name><label>German (De)</label></item><item><name>it</name><label>Italian (It)</label></item><item><name>ar</name><label>Arabic (Ar)</label></item><item><name>hi</name><label>Hindi (Hi)</label></item><item><name>sw</name><label>Swahili (Sw)</label></item><item><name>zh</name><label>Chinese (Zh)</label></item><item><name>kri</name><label>Krio (Kri) — if supported by installed translation engine</label></item></root></instance><instance id="yes_no"><root><item><name>true</name><label>Yes</label></item><item><name>false</name><label>No</label></item></root></instance><bind nodeset="/data/start" jr:preload="timestamp" type="dateTime" jr:preloadParams="start"/><bind nodeset="/data/language_a_input" type="string" required="true()"/><bind nodeset="/data/language_b_input" type="string" required="true()"/><bind nodeset="/data/spoken_output_input" type="string" required="true()"/><bind nodeset="/data/prefer_offline_input" type="string" required="true()"/><bind nodeset="/data/conversation_translation/methodmesh_execution_id" type="string" readonly="true()"/><bind nodeset="/data/conversation_translation/methodmesh_status" type="string" readonly="true()"/><bind nodeset="/data/conversation_translation/conversation_transcript" type="string" readonly="true()"/><bind nodeset="/data/conversation_translation/methodmesh_full_json" type="string" readonly="true()"/><bind nodeset="/data/conversation_done" readonly="true()" type="string" relevant=" /data/conversation_translation/conversation_transcript  != ''"/><bind nodeset="/data/end" jr:preload="timestamp" type="dateTime" jr:preloadParams="end"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/></model></h:head><h:body><select1 ref="/data/language_a_input"><label>First language</label><hint>Download the language pack in MethodMesh settings before offline use.</hint><itemset nodeset="instance('language')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/language_b_input"><label>Second language</label><hint>Download the language pack in MethodMesh settings before offline use.</hint><itemset nodeset="instance('language')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/spoken_output_input"><label>Speak translations aloud</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/prefer_offline_input"><label>Prefer offline speech recognition</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='conversation.translate',input_language_a= /data/language_a_input ,input_language_b= /data/language_b_input ,input_spoken_output= /data/spoken_output_input ,input_prefer_offline= /data/prefer_offline_input ,input_payload_mode='FULL',return_mode='flat')" ref="/data/conversation_translation"><label>Run conversation translator</label><input ref="/data/conversation_translation/methodmesh_execution_id"><label>MethodMesh execution ID</label></input><input ref="/data/conversation_translation/methodmesh_status"><label>MethodMesh status</label></input><input ref="/data/conversation_translation/conversation_transcript"><label>Conversation transcript</label></input><input ref="/data/conversation_translation/methodmesh_full_json"><label>MethodMesh metadata JSON</label></input></group><input ref="/data/conversation_done"><label> Conversation transcript captured: <output value=" /data/conversation_translation/conversation_transcript "/> </label></input></h:body></h:html>