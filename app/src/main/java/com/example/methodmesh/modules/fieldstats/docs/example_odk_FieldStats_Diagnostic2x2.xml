<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>MethodMesh FieldStats: Diagnostic 2x2</h:title><model odk:xforms-version="1.0.0"><instance><data id="methodmesh_fieldstats_diagnostic_2x2" version="2026090401"><intro/><tp/><fp/><fn/><tn/><target_prevalence/><fieldstats_result><diagnostic_sensitivity/><diagnostic_specificity/><diagnostic_ppv/><diagnostic_npv/><diagnostic_lr_positive/><diagnostic_lr_negative/><diagnostic_predictive_ppv/><diagnostic_predictive_npv/><fieldstats_value/><fieldstats_summary/><fieldstats_audit_json/><fieldstats_status/><fieldstats_error/><methodmesh_full_json/></fieldstats_result><meta><instanceID/><instanceName/></meta></data></instance><bind nodeset="/data/intro" readonly="true()" type="string"/><bind nodeset="/data/tp" type="int" required="true()" constraint=". &gt;= 0"/><bind nodeset="/data/fp" type="int" required="true()" constraint=". &gt;= 0"/><bind nodeset="/data/fn" type="int" required="true()" constraint=". &gt;= 0"/><bind nodeset="/data/tn" type="int" required="true()" constraint=". &gt;= 0"/><bind nodeset="/data/target_prevalence" type="decimal" required="true()" constraint=". &gt;= 0 and . &lt;= 1"/><bind nodeset="/data/fieldstats_result/diagnostic_sensitivity" type="string"/><bind nodeset="/data/fieldstats_result/diagnostic_specificity" type="string"/><bind nodeset="/data/fieldstats_result/diagnostic_ppv" type="string"/><bind nodeset="/data/fieldstats_result/diagnostic_npv" type="string"/><bind nodeset="/data/fieldstats_result/diagnostic_lr_positive" type="string"/><bind nodeset="/data/fieldstats_result/diagnostic_lr_negative" type="string"/><bind nodeset="/data/fieldstats_result/diagnostic_predictive_ppv" type="string"/><bind nodeset="/data/fi