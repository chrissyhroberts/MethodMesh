rformance score (%)</label></input><input ref="/data/pvt_result_group/pvt_protocol"><label>Protocol returned by MethodMesh</label></input><input ref="/data/pvt_result_group/methodmesh_status"><label>MethodMesh status</label></input><input appearance="hidden-answer" ref="/data/pvt_result_group/methodmesh_full_json"><label>Full MethodMesh audit JSON</label><hint>Trial-level timings, protocol parameters, device/timing metadata and provenance.</hint></input></group><input ref="/data/pvt_summary"><label>Result: <output value=" /data/pvt_result_group/pvt_result "/></label><hint>Response speed <output value=" /data/pvt_result_group/pvt_response_speed_per_s "/> s⁻¹; lapses <output value=" /data/pvt_result_group/pvt_lapses "/>; false starts <output value=" /data/pvt_result_group/pvt_false_starts "/>.</hint></input></h:body></h:html>