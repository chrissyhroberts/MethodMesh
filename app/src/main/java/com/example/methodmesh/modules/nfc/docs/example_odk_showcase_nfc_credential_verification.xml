<?xml version='1.0' encoding='utf-8'?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>MethodMesh NFC — nfc_credential_verification</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="nfc_showcase_credential_verification" version="2026092202">
          <start />
          <end />
          <introduction />
          <verification_context>
            <study_id />
            <site_code />
            <verification_purpose />
            <verification_purpose_other />
            <expected_credential_id />
            <expected_credential_subject_id />
            <verification_notes />
          </verification_context>
          <issuer_trust_config>
            <issuer_trust_config_note />
            <trusted_issuer_fingerprints_sha256_input />
            <issuer_trust_set_id_input />
            <issuer_trust_set_version_input />
          </issuer_trust_config>
          <run_nfc_credential_verification>
            <methodmesh_execution_id />
            <methodmesh_status />
            <credential_verified />
            <credential_verification_message />
            <credential_id />
            <credential_subject_id />
            <pin_length />
            <credential_format_version />
            <key_derivation />
            <credential_issued_time_iso />
            <credential_envelope_hash />
            <credential_secret_hash />
            <issuer_key_id />
            <issuer_public_key_fingerprint_sha256 />
            <issuer_public_key_base64 />
            <issuer_signature_algorithm />
            <pin_verified />
            <issuer_signature_valid />
            <issuer_trust_status />
            <issuer_trust_basis />
            <issuer_trust_set_id />
            <issuer_trust_set_version />
            <credential_verified_time_iso />
            <tag_uid_hex />
            <verification_evidence_hash />
            <methodmesh_full_json />
          </run_nfc_credential_verification>
          <credential_id_matches_expected />
          <subject_id_matches_expected />
          <verification_summary />
          <credential_mismatch_warning />
          <subject_mismatch_warning />
          <offline_trust_note />
          <meta>
            <instanceID />
          </meta>
        </data>
      </instance>
      <bind nodeset="/data/start" type="dateTime" jr:preload="timestamp" jr:preloadParams="start" />
      <bind nodeset="/data/end" type="dateTime" jr:preload="timestamp" jr:preloadParams="end" />
      <bind nodeset="/data/introduction" type="string" readonly="true()" />
      <bind nodeset="/data/verification_context/study_id" type="string" required="true()" />
      <bind nodeset="/data/verification_context/site_code" type="string" required="true()" />
      <bind nodeset="/data/verification_context/verification_purpose" type="string" required="true()" />
      <bind nodeset="/data/verification_context/verification_purpose_other" type="string" required="true()" relevant="/data/verification_context/verification_purpose = 'other'" />
      <bind nodeset="/data/verification_context/expected_credential_id" type="string" />
      <bind nodeset="/data/verification_context/expected_credential_subject_id" type="string" />
      <bind nodeset="/data/verification_context/verification_notes" type="string" />
      <bind nodeset="/data/issuer_trust_config/issuer_trust_config_note" type="string" readonly="true()" />
      <bind nodeset="/data/issuer_trust_config/trusted_issuer_fingerprints_sha256_input" type="string" required="true()" />
      <bind nodeset="/data/issuer_trust_config/issuer_trust_set_id_input" type="string" required="true()" />
      <bind nodeset="/data/issuer_trust_config/issuer_trust_set_version_input" type="string" required="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/methodmesh_execution_id" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/methodmesh_status" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/credential_verified" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/credential_verification_message" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/credential_id" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/credential_subject_id" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/pin_length" type="int" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/credential_format_version" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/key_derivation" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/credential_issued_time_iso" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/credential_envelope_hash" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/credential_secret_hash" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/issuer_key_id" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/issuer_public_key_fingerprint_sha256" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/issuer_public_key_base64" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/issuer_signature_algorithm" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/pin_verified" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/issuer_signature_valid" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/issuer_trust_status" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/issuer_trust_basis" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/issuer_trust_set_id" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/issuer_trust_set_version" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/credential_verified_time_iso" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/tag_uid_hex" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/verification_evidence_hash" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_verification/methodmesh_full_json" type="string" readonly="true()" />
      <bind nodeset="/data/credential_id_matches_expected" type="string" calculate="if(string-length(/data/verification_context/expected_credential_id) = 0, '', if(/data/verification_context/expected_credential_id = /data/run_nfc_credential_verification/credential_id, 'true', 'false'))" />
      <bind nodeset="/data/subject_id_matches_expected" type="string" calculate="if(string-length(/data/verification_context/expected_credential_subject_id) = 0, '', if(/data/verification_context/expected_credential_subject_id = /data/run_nfc_credential_verification/credential_subject_id, 'true', 'false'))" />
      <bind nodeset="/data/verification_summary" type="string" readonly="true()" relevant="/data/run_nfc_credential_verification/methodmesh_status != ''" />
      <bind nodeset="/data/credential_mismatch_warning" type="string" readonly="true()" relevant="/data/credential_id_matches_expected = 'false'" />
      <bind nodeset="/data/subject_mismatch_warning" type="string" readonly="true()" relevant="/data/subject_id_matches_expected = 'false'" />
      <bind nodeset="/data/offline_trust_note" type="string" readonly="true()" />
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid" />
    </model>
  </h:head>
  <h:body>
    <input ref="/data/introduction">
      <label>Verify a MethodMesh NFC credential</label>
      <hint>MethodMesh verifies the credential signature, checks the issuer against the offline study trust set supplied by this form, and then verifies the PIN when the issuer is acceptable.</hint>
    </input>
    <group ref="/data/verification_context" appearance="field-list">
      <label>Verification context</label>
      <input ref="/data/verification_context/study_id">
        <label>Study / protocol ID</label>
      </input>
      <input ref="/data/verification_context/site_code">
        <label>Site / location code</label>
      </input>
      <select1 ref="/data/verification_context/verification_purpose">
        <label>Reason for verification</label>
        <item>
          <label>Study sign-in / attendance</label>
          <value>study_sign_in</value>
        </item>
        <item>
          <label>Authorise a study procedure</label>
          <value>procedure_authorisation</value>
        </item>
        <item>
          <label>Form / data-entry attestation</label>
          <value>form_attestation</value>
        </item>
        <item>
          <label>Sample or asset handover</label>
          <value>sample_or_asset_handover</value>
        </item>
        <item>
          <label>Participant identification</label>
          <value>participant_identification</value>
        </item>
        <item>
          <label>Other</label>
          <value>other</value>
        </item>
      </select1>
      <input ref="/data/verification_context/verification_purpose_other">
        <label>Other verification purpose</label>
      </input>
      <input ref="/data/verification_context/expected_credential_id">
        <label>Expected credential ID (optional)</label>
        <hint>Optional explicit post-scan cross-check.</hint>
      </input>
      <input ref="/data/verification_context/expected_credential_subject_id">
        <label>Expected subject / registry ID (optional)</label>
        <hint>Optional pseudonymous holder-ID cross-check.</hint>
      </input>
      <input ref="/data/verification_context/verification_notes" appearance="multiline">
        <label>Verification notes</label>
        <hint>Optional workflow notes.</hint>
      </input>
    </group>
    <group ref="/data/issuer_trust_config" appearance="field-list">
      <label>Study issuer trust configuration</label>
      <input ref="/data/issuer_trust_config/issuer_trust_config_note">
        <label>Form-author configuration</label>
        <hint>In a deployed study these values should normally be prefilled/static and hidden from operators. MethodMesh does not contact any server.</hint>
      </input>
      <input ref="/data/issuer_trust_config/trusted_issuer_fingerprints_sha256_input">
        <label>Trusted issuer public-key SHA-256 fingerprints</label>
        <hint>Comma-separated full 64-hex fingerprints exported by approved provisioning devices.</hint>
      </input>
      <input ref="/data/issuer_trust_config/issuer_trust_set_id_input">
        <label>Issuer trust set ID</label>
        <hint>Stable study-defined identifier, e.g. STUDY01_NFC_ISSUERS.</hint>
      </input>
      <input ref="/data/issuer_trust_config/issuer_trust_set_version_input">
        <label>Issuer trust set version</label>
        <hint>Increment whenever the approved issuer list changes.</hint>
      </input>
    </group>
    <group ref="/data/run_nfc_credential_verification" appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='nfc_credential_verification',input_trusted_issuer_fingerprints_sha256=${trusted_issuer_fingerprints_sha256_input},input_issuer_trust_set_id=${issuer_trust_set_id_input},input_issuer_trust_set_version=${issuer_trust_set_version_input},input_payload_mode='FULL',return_mode='flat')">
      <label>Scan and verify NFC credential</label>
      <hint>Scan the credential, complete PIN verification in MethodMesh, then Commit/return.</hint>
      <input ref="/data/run_nfc_credential_verification/methodmesh_execution_id" appearance="hidden-answer">
        <label>MethodMesh execution ID</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/methodmesh_status" appearance="hidden-answer">
        <label>MethodMesh status</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/credential_verified" appearance="hidden-answer">
        <label>Credential verified</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/credential_verification_message" appearance="hidden-answer">
        <label>Verification result</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/credential_id" appearance="hidden-answer">
        <label>Credential ID</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/credential_subject_id" appearance="hidden-answer">
        <label>Credential subject / registry ID</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/pin_length" appearance="hidden-answer">
        <label>PIN length</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/credential_format_version" appearance="hidden-answer">
        <label>Credential format version</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/key_derivation" appearance="hidden-answer">
        <label>Key derivation</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/credential_issued_time_iso" appearance="hidden-answer">
        <label>Credential issued time</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/credential_envelope_hash" appearance="hidden-answer">
        <label>Credential envelope SHA-256</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/credential_secret_hash" appearance="hidden-answer">
        <label>Credential secret SHA-256</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/issuer_key_id" appearance="hidden-answer">
        <label>Issuer short key ID</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/issuer_public_key_fingerprint_sha256" appearance="hidden-answer">
        <label>Issuer public-key SHA-256 fingerprint</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/issuer_public_key_base64" appearance="hidden-answer">
        <label>Issuer public key</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/issuer_signature_algorithm" appearance="hidden-answer">
        <label>Issuer signature algorithm</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/pin_verified" appearance="hidden-answer">
        <label>PIN verified</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/issuer_signature_valid" appearance="hidden-answer">
        <label>Issuer signature valid</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/issuer_trust_status" appearance="hidden-answer">
        <label>Issuer trust status</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/issuer_trust_basis" appearance="hidden-answer">
        <label>Issuer trust basis</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/issuer_trust_set_id" appearance="hidden-answer">
        <label>Issuer trust set ID used</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/issuer_trust_set_version" appearance="hidden-answer">
        <label>Issuer trust set version used</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/credential_verified_time_iso" appearance="hidden-answer">
        <label>Credential verified time</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/tag_uid_hex" appearance="hidden-answer">
        <label>NFC tag UID</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/verification_evidence_hash" appearance="hidden-answer">
        <label>Verification evidence SHA-256</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_verification/methodmesh_full_json" appearance="hidden-answer">
        <label>MethodMesh FULL JSON</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
    </group>
    <input ref="/data/verification_summary">
      <label>Credential verification result</label>
      <hint>Verified <output value="/data/run_nfc_credential_verification/credential_verified" />; signature <output value="/data/run_nfc_credential_verification/issuer_signature_valid" />; issuer trust <output value="/data/run_nfc_credential_verification/issuer_trust_status" /> via <output value="/data/run_nfc_credential_verification/issuer_trust_basis" />; trust set <output value="/data/run_nfc_credential_verification/issuer_trust_set_id" /> v<output value="/data/run_nfc_credential_verification/issuer_trust_set_version" />.</hint>
    </input>
    <input ref="/data/credential_mismatch_warning">
      <label>WARNING: presented credential does not match the expected credential ID.</label>
    </input>
    <input ref="/data/subject_mismatch_warning">
      <label>WARNING: presented credential subject does not match the expected registry ID.</label>
    </input>
    <input ref="/data/offline_trust_note">
      <label>Offline trust evidence retained</label>
      <hint>The verification result records the issuer fingerprint and the exact trust-set ID/version supplied by this form. Later configuration changes do not rewrite this historical result.</hint>
    </input>
  </h:body>
</h:html>