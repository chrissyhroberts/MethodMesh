<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms" xmlns:orx="http://openrosa.org/xforms" xmlns:xsd="http://www.w3.org/2001/XMLSchema"><h:head><h:title>MethodMesh Plus Code capture — plus_code.capture</h:title><model odk:xforms-version="1.0.0"><instance><data id="pluscodecapture_plus_code_capture" version="2026090701"><intro/><run_plus_code_capture><code_length_input/><gps_average_seconds_input/><basemap_mode_input/><grid_span_cells_input/><methodmesh_execution_id/><methodmesh_status/><plus_code/><methodmesh_full_json/></run_plus_code_capture><return_summary/><meta><instanceID/></meta></data></instance><bind nodeset="/data/intro" readonly="true()" type="string"/><bind nodeset="/data/run_plus_code_capture/code_length_input" required="true()" type="string"/><bind nodeset="/data/run_plus_code_capture/gps_average_seconds_input" required="true()" type="string"/><bind nodeset="/data/run_plus_code_capture/basemap_mode_input" required="true()" type="string"/><bind nodeset="/data/run_plus_code_capture/grid_span_cells_input" required="true()" type="string"/><bind nodeset="/data/run_plus_code_capture/methodmesh_execution_id" readonly="true()" type="string"/><bind nodeset="/data/run_plus_code_capture/methodmesh_status" readonly="true()" type="string"/><bind nodeset="/data/run_plus_code_capture/plus_code" readonly="true()" type="string"/><bind nodeset="/data/run_plus_code_capture/methodmesh_full_json" readonly="true()" type="string"/><bind nodeset="/data/return_summary" readonly="true()" type="string"/><bind jr:preload="uid" nodeset="/data/meta/instanceID" readonly="true()" type="string"/></model></h:head><h:body><input ref="/data/intro"><label>MethodMesh Plus Code capture — plus_code.capture</label><hint>Capture a full Open Location Code from GPS and a selected grid cell</hint></input><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='plus_code.capture',input_code_length= /data/run_plus_code_capture/code_length_input ,input_gps_average_seconds= /data/run_plus_code_capture/gps_average_seconds_input ,input_basemap_mode= /data/run_plus_code_capture/basemap_mode_input ,input_grid_span_cells= /data/run_plus_code_capture/grid_span_cells_input ,input_payload_mode='FULL',return_mode='flat')" ref="/data/run_plus_code_capture"><label>Run plus_code.capture</label><select1 ref="/data/run_plus_code_capture/code_length_input"><label>Grid precision</label><item><label>10-digit Plus Code</label><value>10</value></item><item><label>8-digit Plus Code</label><value>8</value></item></select1><select1 ref="/data/run_plus_code_capture/gps_average_seconds_input"><label>GPS averaging time</label><item><label>5 seconds</label><value>5</value></item><item><label>10 seconds</label><value>10</value></item><item><label>20 seconds</label><value>20</value></item></select1><select1 ref="/data/run_plus_code_capture/basemap_mode_input"><label>Map source</label><item><label>Street map</label><value>auto</value></item><item><label>Satellite</label><value>satellite</value></item><item><label>Grid only</label><value>blank</value></item></select1><select1 ref="/data/run_plus_code_capture/grid_span_cells_input"><label>Starting zoom</label><item><label>Wide overview</label><value>129</value></item><item><label>Field</label><value>33</value></item><item><label>Close</label><value>5</value></item></select1><input appearance="hidden-answer" ref="/data/run_plus_code_capture/methodmesh_execution_id"><label>MethodMesh execution ID</label><hint>Returned by MethodMesh.</hint></input><input appearance="hidden-answer" ref="/data/run_plus_code_capture/methodmesh_status"><label>MethodMesh status</label><hint>Shared MethodMesh transport status, where projected by the runtime.</hint></input><input appearance="hidden-answer" ref="/data/run_plus_code_capture/plus_code"><label>Selected full Plus Code</label><hint>Returned by MethodMesh.</hint></input><input appearance="hidden-answer" ref="/data/run_plus_code_capture/methodmesh_full_json"><label>MethodMesh metadata JSON</label><hint>Shared MethodMesh FULL execution envelope. Retained for complete execution/audit capture; capability-specific return fields are projected separately.</hint></input></group><input ref="/data/return_summary"><label>MethodMesh return captured. Status: <output value=" /data/run_plus_code_capture/methodmesh_status "/></label><hint>Only fields relevant to this capability are stored, plus the shared FULL envelope.</hint></input></h:body></h:html>