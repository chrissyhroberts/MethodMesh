<?xml version='1.0' encoding='utf-8'?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>NFC Credential Provisioning</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="nfc_credential_provisioning" version="2026092202">
          <start />
          <end />
          <introduction />
          <study_context>
            <study_id />
            <holder_type />
            <credential_subject_id_input />
            <holder_display_name />
            <holder_role />
            <holder_role_other />
            <site_code />
            <organisation />
            <valid_from_date />
            <valid_until_date />
            <authorised_by />
            <provision_reason />
            <provision_reason_other />
            <registry_notes />
            <credential_registry_key />
          </study_context>
          <credential_options>
            <pin_length_input>6</pin_length_input>
            <overwrite_policy_input>empty_only</overwrite_policy_input>
            <security_note />
          </credential_options>
          <run_nfc_credential_provisioning>
            <methodmesh_execution_id />
            <methodmesh_status />
            <credential_id />
            <credential_subject_id />
            <pin_length />
            <credential_format_version />
            <key_derivation />
            <credential_issued_time_iso />
            <credential_envelope_hash />
            <credential_secret_hash />
            <issuer_key_id />
            <issuer_public_key_fingerprint_sha256 />
            <issuer_public_key_base64 />
            <issuer_signature_algorithm />
            <provision_success />
            <provision_message />
            <provisioned_time_iso />
            <write_record_type />
            <write_size_bytes />
            <overwrite_policy />
            <previous_message_hash />
            <written_message_hash />
            <write_verified />
            <tag_uid_hex />
            <verification_evidence_hash />
            <methodmesh_full_json />
          </run_nfc_credential_provisioning>
          <provision_summary />
          <registry_architecture_note />
          <meta>
            <instanceID />
          </meta>
        </data>
      </instance>
      <bind nodeset="/data/start" type="dateTime" jr:preload="timestamp" jr:preloadParams="start" />
      <bind nodeset="/data/end" type="dateTime" jr:preload="timestamp" jr:preloadParams="end" />
      <bind nodeset="/data/introduction" type="string" readonly="true()" />
      <bind nodeset="/data/study_context/study_id" type="string" required="true()" constraint="string-length(.) &lt;= 64" jr:constraintMsg="Use a study ID of 64 characters or fewer." />
      <bind nodeset="/data/study_context/holder_type" type="string" required="true()" />
      <bind nodeset="/data/study_context/credential_subject_id_input" type="string" required="true()" constraint="string-length(.) &gt;= 2 and string-length(.) &lt;= 64" jr:constraintMsg="Use a stable ID between 2 and 64 characters." />
      <bind nodeset="/data/study_context/holder_display_name" type="string" required="true()" />
      <bind nodeset="/data/study_context/holder_role" type="string" required="true()" />
      <bind nodeset="/data/study_context/holder_role_other" type="string" required="true()" relevant="/data/study_context/holder_role = 'other'" />
      <bind nodeset="/data/study_context/site_code" type="string" required="true()" />
      <bind nodeset="/data/study_context/organisation" type="string" />
      <bind nodeset="/data/study_context/valid_from_date" type="date" required="true()" />
      <bind nodeset="/data/study_context/valid_until_date" type="date" required="true()" constraint=". &gt;= /data/study_context/valid_from_date" jr:constraintMsg="End date must be on or after the start date." />
      <bind nodeset="/data/study_context/authorised_by" type="string" required="true()" />
      <bind nodeset="/data/study_context/provision_reason" type="string" required="true()" />
      <bind nodeset="/data/study_context/provision_reason_other" type="string" required="true()" relevant="/data/study_context/provision_reason = 'other'" />
      <bind nodeset="/data/study_context/registry_notes" type="string" />
      <bind nodeset="/data/study_context/credential_registry_key" type="string" calculate="concat(/data/study_context/study_id, '|', /data/study_context/credential_subject_id_input)" />
      <bind nodeset="/data/credential_options/pin_length_input" type="string" required="true()" />
      <bind nodeset="/data/credential_options/overwrite_policy_input" type="string" required="true()" />
      <bind nodeset="/data/credential_options/security_note" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/methodmesh_execution_id" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/methodmesh_status" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/credential_id" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/credential_subject_id" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/pin_length" type="int" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/credential_format_version" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/key_derivation" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/credential_issued_time_iso" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/credential_envelope_hash" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/credential_secret_hash" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/issuer_key_id" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/issuer_public_key_fingerprint_sha256" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/issuer_public_key_base64" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/issuer_signature_algorithm" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/provision_success" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/provision_message" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/provisioned_time_iso" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/write_record_type" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/write_size_bytes" type="int" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/overwrite_policy" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/previous_message_hash" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/written_message_hash" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/write_verified" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/tag_uid_hex" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/verification_evidence_hash" type="string" readonly="true()" />
      <bind nodeset="/data/run_nfc_credential_provisioning/methodmesh_full_json" type="string" readonly="true()" />
      <bind nodeset="/data/provision_summary" type="string" readonly="true()" relevant="/data/run_nfc_credential_provisioning/methodmesh_status != ''" />
      <bind nodeset="/data/registry_architecture_note" type="string" readonly="true()" />
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid" />
    </model>
  </h:head>
  <h:body>
    <input ref="/data/introduction">
      <label>Provision a MethodMesh NFC credential</label>
      <hint>Study identity and governance remain in ODK. MethodMesh writes only the portable cryptographic credential and returns the issuer identity and audit evidence.</hint>
    </input>
    <group ref="/data/study_context" appearance="field-list">
      <label>Credential holder and study context</label>
      <input ref="/data/study_context/study_id">
        <label>Study / protocol ID</label>
        <hint>Stable study or protocol code.</hint>
      </input>
      <select1 ref="/data/study_context/holder_type">
        <label>Credential holder type</label>
        <item>
          <label>Study staff</label>
          <value>staff</value>
        </item>
        <item>
          <label>Participant</label>
          <value>participant</value>
        </item>
        <item>
          <label>Contractor / temporary staff</label>
          <value>contractor</value>
        </item>
        <item>
          <label>Visitor / monitor</label>
          <value>visitor</value>
        </item>
        <item>
          <label>Other</label>
          <value>other</value>
        </item>
      </select1>
      <input ref="/data/study_context/credential_subject_id_input">
        <label>Credential subject / registry ID</label>
        <hint>Use a stable pseudonymous ID, not a name or email. This is the identifier passed into the portable credential.</hint>
      </input>
      <input ref="/data/study_context/holder_display_name">
        <label>Name / display name</label>
        <hint>Registry field only; not written to the NFC credential.</hint>
      </input>
      <select1 ref="/data/study_context/holder_role">
        <label>Study role</label>
        <item>
          <label>Principal investigator</label>
          <value>principal_investigator</value>
        </item>
        <item>
          <label>Sub-investigator</label>
          <value>sub_investigator</value>
        </item>
        <item>
          <label>Study coordinator</label>
          <value>study_coordinator</value>
        </item>
        <item>
          <label>Research nurse</label>
          <value>research_nurse</value>
        </item>
        <item>
          <label>Clinician</label>
          <value>clinician</value>
        </item>
        <item>
          <label>Laboratory staff</label>
          <value>laboratory_staff</value>
        </item>
        <item>
          <label>Pharmacist / pharmacy staff</label>
          <value>pharmacist</value>
        </item>
        <item>
          <label>Data manager</label>
          <value>data_manager</value>
        </item>
        <item>
          <label>Monitor / auditor</label>
          <value>monitor</value>
        </item>
        <item>
          <label>Fieldworker</label>
          <value>fieldworker</value>
        </item>
        <item>
          <label>Participant</label>
          <value>participant</value>
        </item>
        <item>
          <label>Contractor</label>
          <value>contractor</value>
        </item>
        <item>
          <label>Other</label>
          <value>other</value>
        </item>
      </select1>
      <input ref="/data/study_context/holder_role_other">
        <label>Other role</label>
      </input>
      <input ref="/data/study_context/site_code">
        <label>Site / location code</label>
        <hint>Study site, clinic, laboratory or operating location.</hint>
      </input>
      <input ref="/data/study_context/organisation">
        <label>Organisation / team</label>
        <hint>Optional employing organisation or study team.</hint>
      </input>
      <input ref="/data/study_context/valid_from_date">
        <label>Credential valid from</label>
        <hint>Administrative validity retained by the study registry; not encoded into ROSC1.</hint>
      </input>
      <input ref="/data/study_context/valid_until_date">
        <label>Credential valid until</label>
        <hint>Administrative validity retained by the study registry; not encoded into ROSC1.</hint>
      </input>
      <input ref="/data/study_context/authorised_by">
        <label>Authorised by</label>
        <hint>Name or identifier of the person authorising issuance.</hint>
      </input>
      <select1 ref="/data/study_context/provision_reason">
        <label>Reason for issuing credential</label>
        <item>
          <label>Initial issue</label>
          <value>initial_issue</value>
        </item>
        <item>
          <label>Replacement card</label>
          <value>replacement</value>
        </item>
        <item>
          <label>Renewal</label>
          <value>renewal</value>
        </item>
        <item>
          <label>Role or site change</label>
          <value>role_change</value>
        </item>
        <item>
          <label>Reissue after loss</label>
          <value>reissue_after_loss</value>
        </item>
        <item>
          <label>Other</label>
          <value>other</value>
        </item>
      </select1>
      <input ref="/data/study_context/provision_reason_other">
        <label>Other issuance reason</label>
      </input>
      <input ref="/data/study_context/registry_notes" appearance="multiline">
        <label>Registry notes</label>
        <hint>Optional study administration notes. Do not enter the PIN.</hint>
      </input>
    </group>
    <group ref="/data/credential_options" appearance="field-list">
      <label>Credential security options</label>
      <select1 ref="/data/credential_options/pin_length_input">
        <label>PIN length</label>
        <hint>The PIN is entered only inside MethodMesh.</hint>
        <item>
          <label>4 digits</label>
          <value>4</value>
        </item>
        <item>
          <label>6 digits</label>
          <value>6</value>
        </item>
      </select1>
      <select1 ref="/data/credential_options/overwrite_policy_input">
        <label>Existing card content</label>
        <hint>Use empty_only for new cards. Use replace only when intentionally replacing an existing credential.</hint>
        <item>
          <label>Only write to an empty card</label>
          <value>empty_only</value>
        </item>
        <item>
          <label>Replace existing NDEF content</label>
          <value>replace</value>
        </item>
      </select1>
      <input ref="/data/credential_options/security_note">
        <label>PIN and issuer-key handling</label>
        <hint>The PIN and private issuer key never return to ODK. The private signing key remains in Android Keystore.</hint>
      </input>
    </group>
    <group ref="/data/run_nfc_credential_provisioning" appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='nfc_credential_provisioning',input_credential_subject_id=${credential_subject_id_input},input_pin_length=${pin_length_input},input_overwrite_policy=${overwrite_policy_input},input_payload_mode='FULL',return_mode='flat')">
      <label>Write and verify NFC credential</label>
      <hint>Complete provisioning in MethodMesh, then Commit to return here.</hint>
      <input ref="/data/run_nfc_credential_provisioning/methodmesh_execution_id" appearance="hidden-answer">
        <label>MethodMesh execution ID</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/methodmesh_status" appearance="hidden-answer">
        <label>MethodMesh status</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/credential_id" appearance="hidden-answer">
        <label>Credential ID</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/credential_subject_id" appearance="hidden-answer">
        <label>Credential subject ID returned</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/pin_length" appearance="hidden-answer">
        <label>PIN length</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/credential_format_version" appearance="hidden-answer">
        <label>Credential format version</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/key_derivation" appearance="hidden-answer">
        <label>Key derivation</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/credential_issued_time_iso" appearance="hidden-answer">
        <label>Credential issued time</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/credential_envelope_hash" appearance="hidden-answer">
        <label>Credential envelope SHA-256</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/credential_secret_hash" appearance="hidden-answer">
        <label>Credential secret SHA-256</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/issuer_key_id" appearance="hidden-answer">
        <label>Issuer short key ID</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/issuer_public_key_fingerprint_sha256" appearance="hidden-answer">
        <label>Issuer public-key SHA-256 fingerprint</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/issuer_public_key_base64" appearance="hidden-answer">
        <label>Issuer public key</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/issuer_signature_algorithm" appearance="hidden-answer">
        <label>Issuer signature algorithm</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/provision_success" appearance="hidden-answer">
        <label>Provision success</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/provision_message" appearance="hidden-answer">
        <label>Provisioning result</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/provisioned_time_iso" appearance="hidden-answer">
        <label>Provisioned time</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/write_record_type" appearance="hidden-answer">
        <label>NFC write record type</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/write_size_bytes" appearance="hidden-answer">
        <label>NFC write size (bytes)</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/overwrite_policy" appearance="hidden-answer">
        <label>Applied overwrite policy</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/previous_message_hash" appearance="hidden-answer">
        <label>Previous NFC message SHA-256</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/written_message_hash" appearance="hidden-answer">
        <label>Written NFC message SHA-256</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/write_verified" appearance="hidden-answer">
        <label>NFC write verified</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/tag_uid_hex" appearance="hidden-answer">
        <label>NFC tag UID</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/verification_evidence_hash" appearance="hidden-answer">
        <label>Verification evidence SHA-256</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input ref="/data/run_nfc_credential_provisioning/methodmesh_full_json" appearance="hidden-answer">
        <label>MethodMesh FULL JSON</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
    </group>
    <input ref="/data/provision_summary">
      <label>Credential provisioning result</label>
      <hint>Credential <output value="/data/run_nfc_credential_provisioning/credential_id" />; write verified <output value="/data/run_nfc_credential_provisioning/write_verified" />; issuer <output value="/data/run_nfc_credential_provisioning/issuer_key_id" />; fingerprint <output value="/data/run_nfc_credential_provisioning/issuer_public_key_fingerprint_sha256" />.</hint>
    </input>
    <input ref="/data/registry_architecture_note">
      <label>Registry record retained</label>
      <hint>Name, role, site and administrative validity remain in ODK. The returned full issuer fingerprint is the value to place in the study's offline trusted-issuer configuration.</hint>
    </input>
  </h:body>
</h:html>