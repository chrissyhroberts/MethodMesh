<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms" xmlns:orx="http://openrosa.org/xforms" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <h:head>
    <h:title>MethodMesh SVG polygon selector — svg.select</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="svgselector_svg_select" version="2026091302">
          <intro/>
          <run_svg_select>
            <native_interaction/><methodmesh_status/><svg_name/><selection_mode/><selected_polygons/><selected_polygon_ids/><selected_count/><selection_summary/><polygon_levels/><heatmap_max_level/><selection_events/><selection_audit_hash/><selection_started_at/><selection_completed_at/><methodmesh_full_json/>
          </run_svg_select>
          <return_summary/>
          <meta><instanceID/></meta>
        </data>
      </instance>
      <bind nodeset="/data/intro" readonly="true()" type="string"/>
      <bind nodeset="/data/run_svg_select/native_interaction" readonly="true()" type="string"/>
      <bind nodeset="/data/run_svg_select/methodmesh_status" readonly="true()" type="string"/>
      <bind nodeset="/data/run_svg_select/svg_name" readonly="true()" type="string"/>
      <bind nodeset="/data/run_svg_select/selection_mode" readonly="true()" type="string"/>
      <bind nodeset="/data/run_svg_select/selected_polygons" readonly="true()" type="string"/>
      <bind nodeset="/data/run_svg_select/selected_polygon_ids" readonly="true()" type="string"/>
      <bind nodeset="/data/run_svg_select/selected_count" readonly="true()" type="string"/>
      <bind nodeset="/data/run_svg_select/selection_summary" readonly="true()" type="string"/>
      <bind nodeset="/data/run_svg_select/polygon_levels" readonly="true()" type="string"/>
      <bind nodeset="/data/run_svg_select/heatmap_max_level" readonly="true()" type="string"/>
      <bind nodeset="/data/run_svg_select/selection_events" readonly="true()" type="string"/>
      <bind nodeset="/data/run_svg_select/selection_audit_hash" readonly="true()" type="string"/>
      <bind nodeset="/data/run_svg_select/selection_started_at" readonly="true()" type="string"/>
      <bind nodeset="/data/run_svg_select/selection_completed_at" readonly="true()" type="string"/>
      <bind nodeset="/data/run_svg_select/methodmesh_full_json" readonly="true()" type="string"/>
      <bind nodeset="/data/return_summary" readonly="true()" type="string"/>
      <bind jr:preload="uid" nodeset="/data/meta/instanceID" readonly="true()" type="string"/>
    </model>
  </h:head>
  <h:body>
    <input ref="/data/intro"><label>MethodMesh SVG polygon selector — svg.select</label><hint>Select, sequence, or heat-map polygons on a stored SVG</hint></input>
    <group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='svg.select',input_svg_name='bodymap_black.svg',input_selection_mode='heatmap',input_heatmap_levels='5',return_mode='flat',input_payload_mode='FULL')" ref="/data/run_svg_select">
      <label>Run svg.select</label>
      <input ref="/data/run_svg_select/native_interaction"><label>Complete the capability in MethodMesh, then Commit to return.</label><hint>Repeated taps on a polygon cycle 0 → 1 → 2 → 3 → 4 → 5 → 0.</hint></input>
      <input appearance="hidden-answer" ref="/data/run_svg_select/methodmesh_status"><label>MethodMesh status</label><hint>Shared MethodMesh transport status.</hint></input>
      <input appearance="hidden-answer" ref="/data/run_svg_select/svg_name"><label>SVG filename</label><hint>Returned by MethodMesh.</hint></input>
      <input appearance="hidden-answer" ref="/data/run_svg_select/selection_mode"><label>Selection mode</label><hint>Returned by MethodMesh.</hint></input>
      <input appearance="hidden-answer" ref="/data/run_svg_select/selected_polygons"><label>Selected polygons</label><hint>Heat-map entries contain polygon_id and integer level.</hint></input>
      <input appearance="hidden-answer" ref="/data/run_svg_select/selected_polygon_ids"><label>Selected polygon IDs</label><hint>Convenience JSON array of selected polygon IDs.</hint></input>
      <input appearance="hidden-answer" ref="/data/run_svg_select/selected_count"><label>Selected polygon count</label><hint>Count of selected/non-zero polygons.</hint></input>
      <input appearance="hidden-answer" ref="/data/run_svg_select/selection_summary"><label>Selection summary</label><hint>Human-readable selection projection.</hint></input>
      <input appearance="hidden-answer" ref="/data/run_svg_select/polygon_levels"><label>Polygon heat levels</label><hint>JSON object mapping polygon IDs to heat levels.</hint></input>
      <input appearance="hidden-answer" ref="/data/run_svg_select/heatmap_max_level"><label>Heat-map maximum level</label><hint>Configured maximum non-zero heat level.</hint></input>
      <input appearance="hidden-answer" ref="/data/run_svg_select/selection_events"><label>Selection events</label><hint>Timestamped selection and heat-level events.</hint></input>
      <input appearance="hidden-answer" ref="/data/run_svg_select/selection_audit_hash"><label>Selection audit hash</label><hint>Returned by MethodMesh.</hint></input>
      <input appearance="hidden-answer" ref="/data/run_svg_select/selection_started_at"><label>Selection started</label><hint>Returned by MethodMesh.</hint></input>
      <input appearance="hidden-answer" ref="/data/run_svg_select/selection_completed_at"><label>Selection completed</label><hint>Returned by MethodMesh.</hint></input>
      <input appearance="hidden-answer" ref="/data/run_svg_select/methodmesh_full_json"><label>MethodMesh full JSON</label><hint>Shared FULL execution envelope retained for complete execution/audit capture.</hint></input>
    </group>
    <input ref="/data/return_summary"><label>MethodMesh return captured: <output value="/data/run_svg_select/selection_summary"/></label><hint>The structured result remains available in the hidden return fields and FULL envelope.</hint></input>
  </h:body>
</h:html>
