<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms" xmlns:orx="http://openrosa.org/xforms" xmlns:xsd="http://www.w3.org/2001/XMLSchema"><h:head><h:title>Arcade example</h:title><model odk:xforms-version="1.0.0"><instance><data id="methodmesh_arcade_example" version="2026090702"><intro/><game>launcher</game><snake_speed>relaxed</snake_speed><rng_mode>secure_random</rng_mode><seed/><arcade_group><arcade_result/><arcade_score/><arcade_finished/><arcade_winner/><arcade_state_json/></arcade_group><meta><instanceID/><instanceName/></meta></data></instance><bind nodeset="/data/intro" readonly="true()" type="string"/><bind nodeset="/data/game" required="true()" type="string"/><bind nodeset="/data/snake_speed" relevant=" /data/game  = 'snake'" required="true()" type="string"/><bind nodeset="/data/rng_mode" required="true()" type="string"/><bind nodeset="/data/seed" relevant=" /data/rng_mode  = 'fixed_seed'" type="string"/><bind nodeset="/data/arcade_group/arcade_result" type="string"/><bind nodeset="/data/arcade_group/arcade_score" type="int"/><bind nodeset="/data/arcade_group/arcade_finished" type="string"/><bind nodeset="/data/arcade_group/arcade_winner" type="string"/><bind nodeset="/data/arcade_group/arcade_state_json" type="string"/><bind jr:preload="uid" nodeset="/data/meta/instanceID" readonly="true()" type="string"/><bind calculate="concat('Arcade - ',  /data/game )" nodeset="/data/meta/instanceName" type="string"/></model></h:head><h:body><input ref="/data/intro"><label>MethodMesh Arcade example. Interactive play is primarily native.</label></input><select1 ref="/data/game"><label>Game</label><item><label>Arcade launcher</label><value>launcher</value></item><item><label>Snake Sprint</label><value>snake</value></item><item><label>Pong Table</label><value>pong</value></item><item><label>Brick Breaker</label><value>breakout</value></item><item><label>Lane Dodge</label><value>lane_dodge</value></item></select1><select1 ref="/data/snake_speed"><label>Snake speed</label><item><label>Relaxed</label><value>relaxed</value></item><item><label>Normal</label><value>normal</value></item><item><label>Fast</label><value>fast</value></item><item><label>Turbo</label><value>turbo</value></item></select1><select1 ref="/data/rng_mode"><label>Random source</label><item><label>Secure random</label><value>secure_random</value></item><item><label>Fixed seed</label><value>fixed_seed</value></item></select1><input ref="/data/seed"><label>Fixed seed (only used for fixed_seed)</label></input><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='arcade.snapshot',input_game= /data/game ,input_snake_speed= /data/snake_speed ,input_rng_mode= /data/rng_mode ,input_seed= /data/seed ,input_payload_mode='FULL',return_mode='flat')" ref="/data/arcade_group"><label>Get Arcade snapshot</label><input ref="/data/arcade_group/arcade_result"><label>Arcade result</label></input><input ref="/data/arcade_group/arcade_score"><label>Score</label></input><input ref="/data/arcade_group/arcade_finished"><label>Finished</label></input><input ref="/data/arcade_group/arcade_winner"><label>Winner</label></input><input appearance="hidden-answer" ref="/data/arcade_group/arcade_state_json"><label>Arcade state JSON</label></input></group></h:body></h:html>