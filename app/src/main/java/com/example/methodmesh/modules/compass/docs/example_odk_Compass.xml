<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>MethodMesh Compass example</h:title><model odk:xforms-version="1.0.0"><instance><data id="methodmesh_compass_example" version="2026090602"><intro/><target_mode>north</target_mode><target_bearing/><tolerance_deg>5</tolerance_deg><show_camera>true</show_camera><start_in_sight>true</start_in_sight><run_compass><methodmesh_status/><compass_result/><compass_heading_deg/><compass_cardinal/><compass_target_bearing_deg/><compass_error_deg/><compass_abs_error_deg/><compass_aligned/><compass_tolerance_deg/><compass_heading_axis/><compass_north_reference/><compass_pitch_deg/><compass_roll_deg/><compass_magnetometer_accuracy/><compass_error/><methodmesh_full_json/><compass_status/><compass_target_mode/><compass_view_mode/><compass_captured_time_iso/><compass_audit_json/><methodmesh_closeout_status/></run_compass><summary/><meta><instanceID/><instanceName/></meta></data></instance><instance id="compass_target_mode"><root><item><name>north</name><label>North (magnetic 0°)</label></item><item><name>bearing</name><label>Manual bearing</label></item></root></instance><instance id="yes_no"><root><item><name>true</name><label>Yes</label></item><item><name>false</name><label>No</label></item></root></instance><bind nodeset="/data/intro" readonly="true()" type="string"/><bind nodeset="/data/target_mode" type="string" required="true()"/><bind nodeset="/data/target_bearing" type="decimal" required="true()" relevant=" /data/target_mode  = 'bearing'" constraint=". &gt;= 0 and . &lt; 360" jr:constraintMsg="Enter a bearing from 0 to less than 360 degrees."/><bind nodeset="/data/tolerance_deg" type="decimal" required="true()" constraint=". &gt;= 1 and . &lt;= 30" jr:constraintMsg="Enter a tolerance from 1 to 30 degrees."/><bind nodeset="/data/show_camera" type="string" required="true()"/><bind nodeset="/data/start_in_sight" type="string" required="true()"/><bind nodeset="/data/run_compass/methodmesh_status" type="string"/><bind nodeset="/data/run_compass/compass_result" type="string" readonly="true()"/><bind nodeset="/data/run_compass/compass_heading_deg" type="decimal"/><bind nodeset="/data/run_compass/compass_cardinal" type="string"/><bind nodeset="/data/run_compass/compass_target_bearing_deg" type="decimal"/><bind nodeset="/data/run_compass/compass_error_deg" type="decimal"/><bind nodeset="/data/run_compass/compass_abs_error_deg" type="decimal"/><bind nodeset="/data/run_compass/compass_aligned" type="string"/><bind nodeset="/data/run_compass/compass_tolerance_deg" type="decimal"/><bind nodeset="/data/run_compass/compass_heading_axis" type="string"/><bind nodeset="/data/run_compass/compass_north_reference" type="string"/><bind nodeset="/data/run_compass/compass_pitch_deg" type="decimal"/><bind nodeset="/data/run_compass/compass_roll_deg" type="decimal"/><bind nodeset="/data/run_compass/compass_magnetometer_accuracy" type="int"/><bind nodeset="/data/run_compass/compass_error" type="string"/><bind nodeset="/data/run_compass/methodmesh_full_json" type="string"/><bind nodeset="/data/run_compass/compass_status" type="string"/><bind nodeset="/data/run_compass/compass_target_mode" type="string"/><bind nodeset="/data/run_compass/compass_view_mode" type="string"/><bind nodeset="/data/run_compass/compass_captured_time_iso" type="string"/><bind nodeset="/data/run_compass/compass_audit_json" type="string"/><bind nodeset="/data/run_compass/methodmesh_closeout_status" type="string"/><bind nodeset="/data/summary" readonly="true()" type="string" relevant="string-length( /data/run_compass/compass_result ) &gt; 0"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat('Compass - ',  /data/run_compass/compass_result )"/></model></h:head><h:body><input ref="/data/intro"><label>MethodMesh Compass example</label><hint>Choose magnetic North or enter a bearing. MethodMesh opens the live compass; Commit freezes the reading and returns it to this form.</hint></input><select1 ref="/data/target_mode" appearance="minimal"><label>Target</label><itemset nodeset="instance('compass_target_mode')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/target_bearing"><label>Target bearing (degrees)</label><hint>Used only when Target = Bearing. Enter 0–359.9°.</hint></input><input ref="/data/tolerance_deg"><label>Green-zone tolerance (± degrees)</label><hint>The sighting ring turns green inside this tolerance.</hint></input><select1 ref="/data/show_camera" appearance="minimal"><label>Show camera in sighting mode</label><hint>If camera permission is denied, the reticle still works on a dark background.</hint><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/start_in_sight" appearance="minimal"><label>Start directly in sighting mode</label><hint>Useful when the form is being used as a sighting check.</hint><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='compass.read',input_target_mode= /data/target_mode ,input_target_bearing_deg= /data/target_bearing ,input_alignment_tolerance_deg= /data/tolerance_deg ,input_show_camera_in_sight= /data/show_camera ,input_start_in_sight_mode= /data/start_in_sight ,input_payload_mode='FULL',return_mode='flat')" ref="/data/run_compass"><label>Commit compass reading</label><input ref="/data/run_compass/methodmesh_status" appearance="hidden-answer"><label>MethodMesh status</label></input><input ref="/data/run_compass/compass_result"><label>Committed result</label></input><input ref="/data/run_compass/compass_heading_deg" appearance="hidden-answer"><label>Heading (° magnetic)</label></input><input ref="/data/run_compass/compass_cardinal" appearance="hidden-answer"><label>Cardinal direction</label></input><input ref="/data/run_compass/compass_target_bearing_deg" appearance="hidden-answer"><label>Effective target bearing</label></input><input ref="/data/run_compass/compass_error_deg" appearance="hidden-answer"><label>Signed angular error</label><hint>&gt;0 means turn right; &lt;0 means turn left.</hint></input><input ref="/data/run_compass/compass_abs_error_deg" appearance="hidden-answer"><label>Absolute angular error</label></input><input ref="/data/run_compass/compass_aligned" appearance="hidden-answer"><label>Aligned</label></input><input ref="/data/run_compass/compass_tolerance_deg" appearance="hidden-answer"><label>Returned tolerance</label></input><input ref="/data/run_compass/compass_heading_axis" appearance="hidden-answer"><label>Heading axis</label></input><input ref="/data/run_compass/compass_north_reference" appearance="hidden-answer"><label>North reference</label></input><input ref="/data/run_compass/compass_pitch_deg" appearance="hidden-answer"><label>Pitch at capture</label></input><input ref="/data/run_compass/compass_roll_deg" appearance="hidden-answer"><label>Roll at capture</label></input><input ref="/data/run_compass/compass_magnetometer_accuracy" appearance="hidden-answer"><label>Android magnetometer accuracy</label></input><input ref="/data/run_compass/compass_error" appearance="hidden-answer"><label>Error</label></input><input ref="/data/run_compass/methodmesh_full_json" appearance="hidden-answer"><label>Full MethodMesh JSON</label><hint>Background metadata/audit payload returned by FULL mode.</hint></input><input ref="/data/run_compass/compass_status" appearance="hidden-answer"><label>Capability status</label></input><input ref="/data/run_compass/compass_target_mode" appearance="hidden-answer"><label>Returned target mode</label></input><input ref="/data/run_compass/compass_view_mode" appearance="hidden-answer"><label>Capture view mode</label></input><input ref="/data/run_compass/compass_captured_time_iso" appearance="hidden-answer"><label>Commit timestamp (UTC)</label></input><input ref="/data/run_compass/compass_audit_json" appearance="hidden-answer"><label>Compass audit JSON</label><hint>Complete capability audit output; methodmesh_full_json remains the standard full MethodMesh envelope.</hint></input><input ref="/data/run_compass/methodmesh_closeout_status" appearance="hidden-answer"><label>MethodMesh closeout status</label></input></group><input ref="/data/summary"><label> Compass result: <output value=" /data/run_compass/compass_result "/> </label><hint> Magnetic heading <output value=" /data/run_compass/compass_heading_deg "/>°. Target <output value=" /data/run_compass/compass_target_bearing_deg "/>°. Alignment: <output value=" /data/run_compass/compass_aligned "/>. Closeout: <output value=" /data/run_compass/methodmesh_closeout_status "/>. </hint></input></h:body></h:html>