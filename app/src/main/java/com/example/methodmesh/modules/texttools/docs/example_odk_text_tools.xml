="com.example.methodmesh.EXECUTE_METHOD(method_id='text.clean',input_text= /data/clean_source ,input_operations='trim|normalize_line_endings|collapse_blank_lines',input_unicode_normalization='nfc',return_mode='flat',methodmesh_return_namespace='clean')" ref="/data/clean_mm"><label>Clean text with MethodMesh</label><input ref="/data/clean_mm/clean_text_cleaned"><label>Cleaned text</label></input><input ref="/data/clean_mm/clean_text_characters_removed"><label>Characters removed</label></input><input ref="/data/clean_mm/clean_text_lines_after"><label>Lines after cleaning</label></input><input appearance="hidden-answer" ref="/data/clean_mm/clean_methodmesh_full_json"><label>MethodMesh full JSON</label></input></group><input ref="/data/case_source"><label>Text to convert to upper case</label></input><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='text.case',input_text= /data/case_source ,input_mode='uppercase',input_locale_policy='root',return_mode='flat',methodmesh_return_namespace='case')" ref="/data/case_mm"><label>Change text case with MethodMesh</label><input ref="/data/case_mm/case_text_case_result"><label>Case-converted text</label></input><input appearance="hidden-answer" ref="/data/case_mm/case_methodmesh_full_json"><label>MethodMesh full JSON</label></input></group><input ref="/data/replace_source"><label>Text containing semicolons</label></input><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='text.replace',input_text= /data/replace_source ,input_search=';',input_replacement=',',input_mode='literal',input_scope='all',input_case_sensitive='true',return_mode='flat',methodmesh_return_namespace='replace')" ref="/data/replace_mm"><label>Replace semicolons with commas</label><input ref="/data/replace_mm/replace_text_replaced"><label>Replaced text</label></input><input ref="/data/replace_mm/replace_text_matches_found"><label>Matches found</label></input><input ref="/data/replace_mm/replace_text_replacements_made"><label>Replacements made</label></input><input appearance="hidden-answer" ref="/data/replace_mm/replace_methodmesh_full_json"><label>MethodMesh full JSON</label></input></group><input ref="/data/lines_source"><label>One item per line, including possible duplicates</label></input><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='text.lines',input_text= /data/lines_source ,input_operation='deduplicate_preserve_order',input_trim_lines='true',input_case_sensitive='true',return_mode='flat',methodmesh_return_namespace='lines')" ref="/data/lines_mm"><label>Deduplicate lines preserving order</label><input ref="/data/lines_mm/lines_text_lines_result"><label>Unique lines</label></input><input ref="/data/lines_mm/lines_text_output_line_count"><label>Output line count</label></input><input ref="/data/lines_mm/lines_text_duplicate_count"><label>Duplicates removed</label></input><input appearance="hidden-answer" ref="/data/lines_mm/lines_methodmesh_full_json"><label>MethodMesh full JSON</label></input></group><input ref="/data/split_source"><label>Comma-separated values</label></input><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='text.split_join',input_text= /data/split_source ,input_operation='split',input_delimiter='comma',input_trim_values='true',input_discard_empty='true',return_mode='flat',methodmesh_return_namespace='split')" ref="/data/split_mm"><label>Split comma-separated values</label><input ref="/data/split_mm/split_text_split_join_result"><label>One item per line</label></input><input ref="/data/split_mm/split_text_item_count"><label>Item count</label></input><input appearance="hidden-answer" ref="/data/split_mm/split_methodmesh_full_json"><label>MethodMesh full JSON</label></input></group><input ref="/data/count_source"><label>Text to count</label></input><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='text.count',input_text= /data/count_source ,return_mode='flat',methodmesh_return_namespace='count')" ref="/data/count_mm"><label>Count text</label><input ref="/data/count_mm/count_text_count_summary"><label>Count summary</label></input><input ref="/data/count_mm/count_text_word_count"><label>Words</label></input><input ref="/data/count_mm/count_text_character_count"><label>Characters</label></input><input ref="/data/count_mm/count_text_line_count"><label>Lines</label></input><input ref="/data/count_mm/count_text_paragraph_count"><label>Paragraphs</label></input><input ref="/data/count_mm/count_text_utf8_byte_count"><label>UTF-8 bytes</label></input><input appearance="hidden-answer" ref="/data/count_mm/count_methodmesh_full_json"><label>MethodMesh full JSON</label></input></group><input ref="/data/extract_source"><label>Text containing email addresses</label></input><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='text.extract',input_text= /data/extract_source ,input_operation='pattern',input_pattern='email',return_mode='flat',methodmesh_return_namespace='extract')" ref="/data/extract_mm"><label>Extract email-like strings</label><input ref="/data/extract_mm/extract_text_extract_result"><label>Extracted matches</label></input><input ref="/data/extract_mm/extract_text_match_count"><label>Match count</label></input><input ref="/data/extract_mm/extract_text_matches_json"><label>Matches JSON</label></input><input appearance="hidden-answer" ref="/data/extract_mm/extract_methodmesh_full_json"><label>MethodMesh full JSON</label></input></group><input ref="/data/truncate_source"><label>Text to truncate</label></input><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='text.truncate',input_text= /data/truncate_source ,input_limit='100',input_unit='characters',input_retain='start',input_suffix='ellipsis',return_mode='flat',methodmesh_return_namespace='truncate')" ref="/data/truncate_mm"><label>Truncate to 100 characters</label><input ref="/data/truncate_mm/truncate_text_truncated"><label>Truncated text</label></input><input ref="/data/truncate_mm/truncate_text_result_length"><label>Result length</label></input><input ref="/data/truncate_mm/truncate_text_was_truncated"><label>Was truncated</label></input><input appearance="hidden-answer" ref="/data/truncate_mm/truncate_methodmesh_full_json"><label>MethodMesh full JSON</label></input></group><input ref="/data/slug_source"><label>Text to make into a slug</label></input><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='text.slug',input_text= /data/slug_source ,input_separator='hyphen',input_lowercase='true',input_ascii_only='true',return_mode='flat',methodmesh_return_namespace='slug')" ref="/data/slug_mm"><label>Make a slug</label><input ref="/data/slug_mm/slug_text_slug"><label>Slug</label></input><input appearance="hidden-answer" ref="/data/slug_mm/slug_methodmesh_full_json"><label>MethodMesh full JSON</label></input></group><input ref="/data/encode_source"><label>Text to Base64 encode</label></input><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='text.encode',input_text= /data/encode_source ,input_operation='base64_encode',return_mode='flat',methodmesh_return_namespace='encode')" ref="/data/encode_mm"><label>Base64 encode text</label><input ref="/data/encode_mm/encode_text_encoded_result"><label>Encoded text</label></input><input ref="/data/encode_mm/encode_text_encoding_operation"><label>Encoding operation</label></input><input appearance="hidden-answer" ref="/data/encode_mm/encode_methodmesh_full_json"><label>MethodMesh full JSON</label></input></group></h:body></h:html>