ult/detection_rule_of_three_upper" appearance="hidden-answer"><label>Rule-of-three upper approximation</label></input><input ref="/data/fieldstats_result/fieldstats_value" appearance="hidden-answer"><label>Main Field Statistics result</label></input><input ref="/data/fieldstats_result/fieldstats_summary" appearance="hidden-answer"><label>Human-readable summary</label></input><input ref="/data/fieldstats_result/fieldstats_audit_json" appearance="hidden-answer"><label>Field Statistics audit JSON</label></input><input ref="/data/fieldstats_result/fieldstats_status" appearance="hidden-answer"><label>Execution status</label></input><input ref="/data/fieldstats_result/fieldstats_error" appearance="hidden-answer"><label>Error message</label></input><input ref="/data/fieldstats_result/methodmesh_full_json" appearance="hidden-answer"><label>Full MethodMesh result envelope</label></input></group></h:body></h:html>