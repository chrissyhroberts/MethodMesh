<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>MethodMesh FieldStats: Detection / zero events</h:title><model odk:xforms-version="1.0.0"><instance><data id="methodmesh_fieldstats_detection" version="2026090401"><intro/><mode/><prevalence/><sample_size/><population_size/><fieldstats_result><detection_required_n/><detection_probability/><detection_upper_prevalence/><detection_rule_of_three_upper/><fieldstats_value/><fieldstats_summary/><fieldstats_audit_json/><fieldstats_status/><fieldstats_error/><methodmesh_full_json/></fieldstats_result><meta><instanceID/><instanceName/></meta></data></instance><instance id="detection_mode"><root><item><name>plan_detection</name><label>Plan: detect at least one</label></item><item><name>zero_events</name><label>Result: zero events observed</label></item></root></instance><bind nodeset="/data/intro" readonly="true()" type="string"/><bind nodeset="/data/mode" type="string" required="true()"/><bind nodeset="/data/prevalence" type="decimal" required="true()" relevant=" /data/mode  = 'plan_detection'" constraint=". &gt; 0 and . &lt;= 1"/><bind nodeset="/data/sample_size" type="int" required="true()" relevant=" /data/mode  = 'zero_events'" constraint=". &gt; 0"/><bind nodeset="/data/population_size" type="int" required="true()" constraint=". &gt;= 0"/><bind nodeset="/data/fieldstats_result/detection_required_n" type="string"/><bind nodeset="/data/fieldstats_result/detection_probability" type="string"/><bind nodeset="/data/fieldstats_result/detection_upper_prevalence" type="string"/><bind nodeset="/data/fieldstats_result/detection_rule_of_three_upper" type="string"/><bind nodeset="/data/fieldstats_result/fieldstats_value" type="string"/><bind nodeset="/