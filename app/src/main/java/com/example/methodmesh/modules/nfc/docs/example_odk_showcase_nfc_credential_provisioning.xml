  </h:head>
  <h:body>
    <input ref="/data/intro">
      <label>MethodMesh NFC — nfc_credential_provisioning</label>
      <hint>Create a PIN-protected portable NFC credential and capture the canonical provisioning-device issuer fingerprint.</hint>
    </input>
    <group appearance="field-list" ref="/data/run_nfc_credential_provisioning" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='nfc_credential_provisioning',input_payload_mode='FULL',return_mode='flat')">
      <label>Run nfc_credential_provisioning</label>
      <input ref="/data/run_nfc_credential_provisioning/native_interaction">
        <label>Complete the capability in MethodMesh, then Commit to return.</label>
        <hint>No study trust-list is embedded in this form. Provisioning records actual cryptographic issuer evidence; later study systems decide whether that issuer was registered and authorised.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/methodmesh_execution_id">
        <label>MethodMesh execution ID</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/methodmesh_status">
        <label>MethodMesh status</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/credential_id">
        <label>Credential ID</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/credential_subject_id">
        <label>Credential subject / registry ID</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/pin_length">
        <label>PIN length</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/credential_format_version">
        <label>Credential format version</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/key_derivation">
        <label>Key derivation</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/credential_issued_time_iso">
        <label>Credential issued time</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/credential_envelope_hash">
        <label>Credential envelope SHA-256</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/credential_secret_hash">
        <label>Credential secret SHA-256</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/issuer_key_id">
        <label>Issuer key ID</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/issuer_public_key_fingerprint_sha256">
        <label>Issuer public key SHA-256 fingerprint</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/issuer_public_key_base64">
        <label>Issuer public key</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/issuer_signature_algorithm">
        <label>Issuer signature algorithm</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/provision_success">
        <label>Provision success</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/provision_message">
        <label>Provisioning result</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/provisioned_time_iso">
        <label>Provisioned time</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/write_record_type">
        <label>NFC write record type</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/write_size_bytes">
        <label>NFC write size (bytes)</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/overwrite_policy">
        <label>Applied overwrite policy</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/previous_message_hash">
        <label>Previous NFC message SHA-256</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/written_message_hash">
        <label>Written NFC message SHA-256</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/write_verified">
        <label>NFC write verified</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/tag_uid_hex">
        <label>NFC tag UID</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/verification_evidence_hash">
        <label>Provisioning verification evidence SHA-256</label>
        <hint>Returned by MethodMesh.</hint>
      </input>
      <input appearance="hidden-answer" ref="/data/run_nfc_credential_provisioning/methodmesh_full_json">
        <label>MethodMesh FULL JSON</label>
        <hint>Shared MethodMesh FULL execution envelope retained for complete execution/audit capture.</hint>
      </input>
    </group>
    <input ref="/data/return_summary">
      <label>MethodMesh provisioning return captured. Status: <output value="/data/run_nfc_credential_provisioning/methodmesh_status"/></label>
      <hint>The returned credential ID and full issuer fingerprint are sufficient to link this provisioning event to the study credential and provisioning-device registries.</hint>
    </input>
  </h:body>
</h:html>
