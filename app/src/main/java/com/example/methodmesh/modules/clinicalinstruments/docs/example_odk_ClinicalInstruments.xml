result_group/clinical_version" type="string"/><bind nodeset="/data/clinical_result_group/clinical_definition_fingerprint" type="string"/><bind nodeset="/data/clinical_result_group/clinical_session" type="string"/><bind nodeset="/data/clinical_result_group/clinical_response_eye_response" type="string"/><bind nodeset="/data/clinical_result_group/clinical_response_verbal_response" type="string"/><bind nodeset="/data/clinical_result_group/clinical_response_motor_response" type="string"/><bind nodeset="/data/clinical_result_group/clinical_derived_any_component_nt" type="string"/><bind nodeset="/data/clinical_result_group/clinical_score_gcs_total" type="string"/><bind nodeset="/data/clinical_result_group/clinical_instrument_id" type="string"/><bind nodeset="/data/clinical_result_group/clinical_instrument_name" type="string"/><bind nodeset="/data/clinical_result_group/clinical_instrument_version" type="string"/><bind nodeset="/data/clinical_result_group/clinical_definition_sha256" type="string"/><bind nodeset="/data/clinical_result_group/clinical_subject_id" type="string"/><bind nodeset="/data/clinical_result_group/clinical_session_id" type="string"/><bind nodeset="/data/clinical_result_group/clinical_responses_json" type="string"/><bind nodeset="/data/clinical_result_group/clinical_derived_json" type="string"/><bind nodeset="/data/clinical_result_group/clinical_result_json" type="string"/><bind nodeset="/data/clinical_result_group/clinical_completed_time_iso" type="string"/><bind nodeset="/data/clinical_result_group/clinical_error" type="string"/><bind nodeset="/data/clinical_result_group/methodmesh_full_json" type="string"/><bind nodeset="/data/result_note" readonly="true()" type="string"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/instrument_id , ' - ',  /data/subject_id )"/></model></h:head><h:body><input ref="/data/intro"><label>MethodMesh Clinical Instruments</label><hint>ODK supplies case context and the instrument ID. MethodMesh presents the established linear checklist, validates it, calculates the result offline, and returns observations plus exact instrument provenance.</hint></input><input ref="/data/subject_id"><label>Patient / participant / case ID</label><hint>Optional identifier passed to MethodMesh and returned with the result.</hint></input><input ref="/data/session_label"><label>Session label</label><hint>Optional human-readable label for the MethodMesh Active Instruments registry.</hint></input><select1 ref="/data/instrument_id"><label>Clinical instrument</label><hint>This XLSForm intentionally does not contain the established instrument questions.</hint><itemset nodeset="instance('clinical_instruments')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='clinical.instrument.run',input_instrument_id= /data/instrument_id ,input_subject_id= /data/subject_id ,input_session_label= /data/session_label ,input_payload_mode='FULL',return_mode='flat')" ref="/data/clinical_result_group"><label>Run instrument in MethodMesh</label><input ref="/data/clinical_result_group/clinical_status" appearance="hidden-answer"><label>MethodMesh status</label></input><input ref="/data/clinical_result_group/clinical_result"><label>Headline clinical result</label></input><input ref="/data/clinical_result_group/clinical_answers"><label>Ordered individual answers</label></input><input ref="/data/clinical_result_group/clinical_score"><label>Primary score</label></input><input ref="/data/clinical_result_group/clinical_classification"><label>Classification</label></input><input ref="/data/clinical_result_group/clinical_instrument" appearance="hidden-answer"><label>Instrument ID</label></input><input ref="/data/clinical_result_group/clinical_version" appearance="hidden-answer"><label>Instrument version</label></input><inpu