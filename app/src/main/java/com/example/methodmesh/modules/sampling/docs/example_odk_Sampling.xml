<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>MethodMesh Sampling example</h:title><model odk:xforms-version="1.0.0"><instance><data id="methodmesh_sampling_example" version="2026090302"><intro/><household_size/><eligible_people jr:template=""><person_id/></eligible_people><eligible_people><person_id/></eligible_people><eligible_ids/><sampling_result><sampling_selected_id/><sampling_value/><sampling_audit_json/><sampling_provenance_payload_sha256/><sampling_attestation_event_payload_hash/><methodmesh_full_json/></sampling_result><selected_note/><provenance_note/><meta><instanceID/><instanceName/></meta></data></instance><bind nodeset="/data/intro" readonly="true()" type="string"/><bind nodeset="/data/household_size" type="int" required="true()"/><bind nodeset="/data/eligible_people/person_id" type="string" required="true()"/><bind nodeset="/data/eligible_ids" type="string" calculate="join('|',  /data/eligible_people/person_id )"/><bind nodeset="/data/sampling_result/sampling_selected_id" type="string"/><bind nodeset="/data/sampling_result/sampling_value" type="string"/><bind nodeset="/data/sampling_result/sampling_audit_json" type="string"/><bind nodeset="/data/sampling_result/sampling_provenance_payload_sha256" type="string"/><bind nodeset="/data/sampling_result/sampling_attestation_event_payload_hash" type="string"/><bind nodeset="/data/sampling_result/methodmesh_full_json" type="string"/><bind nodeset="/data/selected_note" readonly="true()" type="string"/><bind nodeset="/data/provenance_note" readonly="true()" type="string"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat('Sampling - ',  /data/sampling_result/sampling_selected_id )"/></model></h:head><h:body><input ref="/data/intro"><label>This example lists eligible household members and asks MethodMesh Sampling to select one at random.</label></input><input ref="/data/household_size"><label>How many eligible household members are in the sampling roster?</label></input><group ref="/data/eligible_people"><label>Eligible household member</label><repeat nodeset="/data/eligible_people" jr:count=" /data/household_size "><input ref="/data/eligible_people/person_id"><label>Household member ID</label></input></repeat></group><group appearance="field-list" intent="com.example.methodmesh.EXECUTE_METHOD(method_id='sampling.run',input_source_type='manual',input_manual_items= /data/eligible_ids ,input_manual_separator='pipe',input_operation='simple_sample',input_sample_mode='n',input_sample_size='1',input_replacement='false',input_output_mode='selected_only',input_output_format='json',input_seed_mode='auto',input_payload_mode='FULL',return_mode='flat')" ref="/data/sampling_result"><label>Randomly select one household member</label><input ref="/data/sampling_result/sampling_selected_id"><label>Selected household member</label></input><input ref="/data/sampling_result/sampling_value" appearance="hidden-answer"><label>Selected value</label></input><input ref="/data/sampling_result/sampling_audit_json" appearance="hidden-answer"><label>Sampling provenance / audit JSON</label></input><input ref="/data/sampling_result/sampling_provenance_payload_sha256" appearance="hidden-answer"><label>Sampling provenance SHA-256</label></input><input ref="/data/sampling_result/sampling_attestation_event_payload_hash" appearance="hidden-answer"><label>Hash ready for Traceable attestation</label></input><input ref="/data/sampling_result/methodmesh_full_json" appearance="hidden-answer"><label>Full MethodMesh result envelope</label></input></group><input ref="/data/selected_note"><label> Selected household member: <output value=" /data/sampling_result/sampling_selected_id "/> </label></input><input ref="/data/provenance_note"><label>sampling_audit_json stores the capability provenance. sampling_provenance_payload_sha256 can be piped into Traceable attestation as event_payload_hash for a TSA-backed timestamp.</label></input></h:body></h:html>